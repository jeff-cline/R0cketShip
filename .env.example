# Postgres connection for the app.
# In dev/test, this points at localhost:5432, which is an SSH tunnel to the
# Vultr box's Postgres (the DB is localhost-bound on the box, reached via:
#   ssh -fNT -L 127.0.0.1:5432:127.0.0.1:5432 r0cketship )
# In production (on the Vultr box itself), point this at the local Postgres directly.
DATABASE_URL=postgres://r0cketship:CHANGEME@localhost:5432/r0cketship_dev

# For local multi-tenant testing: which tenant a bare localhost request resolves to.
# Leave unset in production so real Host headers resolve tenants.
DEFAULT_TENANT_DOMAIN=roofers.co
